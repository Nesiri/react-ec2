{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "react-ec2-task-definition",
    "containerDefinitions": [
        {
            "name": "react-ec2-container",
            "image": "450730497128.dkr.ecr.us-east-2.amazonaws.com/ec2_image:latest",
            "portMappings": [
                {
                    "name": "ngnix-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::450730497128:role/ecsTaskExecutionRole"
}